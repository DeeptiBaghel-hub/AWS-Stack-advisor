{
  "name": "aws-stack-advisor-server",
  "version": "1.0.0",
  "description": "API for AWS Stack Advisor - recommends AWS architectures based on project requirements",
  "main": "src/index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "seed": "node src/scripts/seed.js",
    "test": "node src/utils/recommendationEngine.test.js && node src/utils/wellArchitectedScorer.test.js",
    "test:integration": "node --test test/*.test.js",
    "test:all": "npm test && npm run test:integration"
  },
  "dependencies": {
    "@sentry/node": "^10.70.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.0",
    "express-validator": "^7.1.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.4",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2"
  }
}
